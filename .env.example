# Go 백엔드 환경변수
OPENAI_API_KEY=sk-...
PORT=8080

# 프로젝트 루트 경로 (main.go 에서 code/main.py 위치 탐색 기준)
# Windows 예시:
# PROJECT_ROOT=D:\Projects\capstone_music_ver2
# Mac/Linux 예시:
# PROJECT_ROOT=/Users/yourname/capstone_music_ver2

# Python 실행 명령어 (기본값: python3)
# Mac Anaconda 환경 예시 (conda activate capstone 후 which python 결과값 사용):
# PYTHON_CMD=/opt/homebrew/anaconda3/envs/capstone/bin/python
# Apple Silicon M1/M2 기본 경로:
# PYTHON_CMD=/opt/homebrew/opt/python@3.10/bin/python3
# Windows PATH에 python 등록된 경우 생략 가능:
# PYTHON_CMD=python

# ── PWA 개발 전용 (프로덕션/Docker에서는 불필요) ─────────────────────────
# 개발 서버(npm run dev)에서 Go 백엔드를 따로 실행할 때만 설정
# 프로덕션은 Go가 dist/를 직접 서빙하므로 비워둠 (상대 경로 자동 사용)
# VITE_API_BASE=http://localhost:8080
